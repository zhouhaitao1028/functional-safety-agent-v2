# 知识库可使用独立的 OpenAI-compatible Embedding 服务。
# 未配置时使用离线开发向量；切换模型后必须重新构建索引。
FS_KNOWLEDGE_EMBEDDING_BASE_URL=
FS_KNOWLEDGE_EMBEDDING_API_KEY=
FS_KNOWLEDGE_EMBEDDING_MODEL=

# 软件接口 MCP 只允许读写这些根目录。Windows 下多个目录以分号分隔。
# 未配置时仅允许 MCP 进程的当前工作目录。
FS_INTERFACE_MCP_ALLOWED_ROOTS=
