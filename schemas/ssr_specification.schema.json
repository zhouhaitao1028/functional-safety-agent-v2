{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Software Safety Requirements Specification",
  "type": "object",
  "required": ["requirements"],
  "properties": {
    "requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id", "statement", "asil", "category", "operating_mode",
          "allocation", "implemented_by", "parent_tsr_ids",
          "verification_criteria", "status", "owner"
        ],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "statement": {"type": "string", "minLength": 1},
          "asil": {"type": "string", "enum": ["QM", "A", "B", "C", "D"]},
          "category": {"type": "string", "minLength": 1},
          "operating_mode": {"type": "string", "minLength": 1},
          "allocation": {"type": "string", "minLength": 1},
          "implemented_by": {"type": "string", "minLength": 1},
          "parent_tsr_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "verification_criteria": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "status": {"type": "string", "minLength": 1},
          "owner": {"type": "string", "minLength": 1},
          "assumptions": {"type": "array", "items": {"type": "string"}}
        }
      }
    }
  }
}
