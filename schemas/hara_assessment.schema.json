{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HARA Assessment",
  "type": "object",
  "required": ["assessments"],
  "properties": {
    "assessments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "hazardous_event_id", "severity", "exposure", "controllability", "evidence", "safe_state"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "hazardous_event_id": {"type": "string", "minLength": 1},
          "severity": {"type": "string", "enum": ["S0", "S1", "S2", "S3"]},
          "exposure": {"type": "string", "enum": ["E0", "E1", "E2", "E3", "E4"]},
          "controllability": {"type": "string", "enum": ["C0", "C1", "C2", "C3"]},
          "asil": {"type": "string", "enum": ["QM", "A", "B", "C", "D"]},
          "asil_rule_version": {"type": "string"},
          "evidence": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "safe_state": {"type": "string", "minLength": 1},
          "assumptions": {"type": "array", "items": {"type": "string"}}
        }
      }
    }
  }
}

