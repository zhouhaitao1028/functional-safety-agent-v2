{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Functional Safety Requirements",
  "type": "object",
  "required": ["requirements"],
  "properties": {
    "requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "safety_goal_ids", "statement", "asil", "allocation", "verification_criteria"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "safety_goal_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "fault_tree_node_ids": {"type": "array", "items": {"type": "string"}},
          "statement": {"type": "string", "minLength": 1},
          "asil": {"type": "string", "enum": ["QM", "A", "B", "C", "D"]},
          "allocation": {"type": "string", "minLength": 1},
          "timing_constraint": {"type": "string"},
          "verification_criteria": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "assumptions": {"type": "array", "items": {"type": "string"}}
        }
      }
    }
  }
}

