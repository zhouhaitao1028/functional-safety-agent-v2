{
  "type": "object",
  "required": ["id", "version", "goal", "inputs", "work_items"],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "goal": {"type": "string", "minLength": 1},
    "inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "type"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "type": {"type": "string", "minLength": 1},
          "location": {"type": "string"}
        }
      }
    },
    "work_items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "title", "agent_id", "depends_on", "input_refs", "output", "approval_required"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "title": {"type": "string", "minLength": 1},
          "agent_id": {"type": "string", "minLength": 1},
          "depends_on": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "input_refs": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "output": {
            "type": "object",
            "required": ["id", "type", "artifact"],
            "properties": {
              "id": {"type": "string", "minLength": 1},
              "type": {"type": "string", "minLength": 1},
              "artifact": {"type": "string", "minLength": 1}
            }
          },
          "parameters": {
            "type": "object",
            "properties": {
              "operation": {
                "type": "string",
                "enum": ["analyze_package", "generate_overview", "compare_overviews"]
              },
              "engine": {
                "type": "string",
                "enum": ["fast", "legacy", "auto"]
              },
              "compare_to_existing": {"type": "boolean"},
              "visible": {"type": "boolean"},
              "timeout_seconds": {"type": "integer"},
              "max_evidence": {"type": "integer"},
              "max_findings": {"type": "integer"}
            }
          },
          "approval_required": {"type": "boolean"}
        }
      }
    }
  }
}
