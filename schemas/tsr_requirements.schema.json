{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Technical Safety Requirements Input",
  "type": "object",
  "required": ["requirements"],
  "properties": {
    "requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "statement", "asil", "allocation", "source_refs"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "statement": {"type": "string", "minLength": 1},
          "asil": {"type": "string", "enum": ["QM", "A", "B", "C", "D"]},
          "allocation": {"type": "string", "minLength": 1},
          "source_refs": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "notes": {"type": "string"}
        }
      }
    }
  }
}
