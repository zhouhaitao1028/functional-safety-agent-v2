{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Traceability",
  "type": "object",
  "required": ["links", "required_target_ids"],
  "properties": {
    "links": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["source_id", "target_id", "type"],
        "properties": {
          "source_id": {"type": "string", "minLength": 1},
          "target_id": {"type": "string", "minLength": 1},
          "type": {"type": "string", "minLength": 1},
          "evidence": {"type": "string"}
        }
      }
    },
    "required_target_ids": {"type": "array", "items": {"type": "string"}},
    "validation": {
      "type": "object",
      "properties": {
        "valid": {"type": "boolean"},
        "dangling_references": {"type": "array"},
        "duplicate_links": {"type": "array"},
        "missing_coverage": {"type": "array"},
        "link_count": {"type": "integer"}
      }
    }
  }
}

